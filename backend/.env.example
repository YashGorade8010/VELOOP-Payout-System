PORT=4000
# Set the complete provider-generated URI. Preserve provider-required options,
# including Railway replica-set/HA options such as directConnection=true.
MONGODB_URI=<provider-generated-mongodb-uri>
# Temporary backwards compatibility for existing local/Render/Atlas setups.
# MONGODB_URI takes precedence when both variables are set.
MONGO_URI=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=2h
CLIENT_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=VELOOP Rewards <no-reply@example.com>
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=replace-with-a-demo-only-password
USER_SEED_EMAIL=user@example.test
USER_SEED_PASSWORD=replace-with-a-demo-only-password
DEMO_STARTING_VES=0
